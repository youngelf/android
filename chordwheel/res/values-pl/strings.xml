    <string name="help_presets_touch">DOTYK: Dotknij/Przeciągnij koło | Przeciągnij struny | Przesuń pasek przewrotu</string>
    <string name="help_presets_keys">KLAWISZE: DPAD=Koło  A=Strum  B=7-ki  L1/R1=Przewrót  X=+Prog  SEL=Blokuj</string>
