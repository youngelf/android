    <string name="help_presets_touch">DOKUNMA: Çemberi Dokun/Sürükle | Telleri Süpür | Pozisyon Çubuğunu Kaydır</string>
    <string name="help_presets_keys">TUŞLAR: DPAD=Çember  A=Çal  B=7\'li  L1/R1=Pozisyon  X=+Akor  SEL=Kilit</string>
